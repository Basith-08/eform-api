APP_ENV=development
APP_NAME=E-Form Employee Management System
PORT=8080
FRONTEND_URL=http://localhost:5173
UPLOAD_PATH=./uploads
MAX_UPLOAD_BYTES=1048576
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
SEED_ON_BOOT=true
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eform
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_TIMEZONE=UTC
JWT_SECRET=change-this-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
