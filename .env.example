APP_ENV=development
APP_NAME=E-Form Employee Management System
APP_PORT=8080
APP_BASE_URL=http://localhost:5173

GHCR_OWNER=your-github-username
IMAGE_TAG=latest
PLATFORM_DOMAIN=your-domain.com

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=eform_db

UPLOAD_PATH=/app/uploads
MAX_UPLOAD_BYTES=1048576
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
SEED_ON_BOOT=false

DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
DB_TIMEZONE=UTC

JWT_SECRET=your-secret-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
